{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "schoolverse-spy-ncxus",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schoolverse-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "schoolverse-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
    }
  ],
  "vars": {
    "SESSION_HOURS": "8",
    "MAX_UPLOAD_MB": "100",
    "PASSWORD_ITERATIONS": "120000",
    "APP_NAME": "SchoolVerse",
    "EMAIL_PROVIDER_URL": "",
    "EMAIL_FROM": ""
  },
  "triggers": {
    "crons": ["0 * * * *", "0 0 * * *"]
  }
}
